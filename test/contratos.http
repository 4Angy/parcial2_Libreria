# Contratos HTTP de los changes 03 y 04.
#
# Ejecutar con `uvicorn app.main:app --port 8000` y la base sembrada.
# Cada bloque declara `# esperado:` y las comprobaciones que hace el ejecutor:
#   # captura: nombre        guarda el `id` de la respuesta y `{{nombre}}` lo reutiliza
#   # contiene: a; b         fragmentos que deben aparecer en el cuerpo
#   # no-contiene: a; b      fragmentos que no deben aparecer
#   # cantidad: n            cantidad de elementos de una lista
#   # lista-vacia: si        el cuerpo debe ser `[]`
#   # es-null: campo         el campo debe ser `null`
#   # todos-genero: id       todos los elementos deben tener ese `genero.id`
#   # termina-en-z: campo    el campo debe terminar en `Z`
#   # guarda-lista: nombre   guarda los `id` de una lista
#   # sin-solape-con: nombre las dos listas no comparten elementos
#
# Los datos creados usan el prefijo `Prueba 03` o `Prueba 04`. El bloque SQL de
# limpieza está al final del archivo.

### Salud: el proceso sigue vivo
# esperado: 200
# contiene: "estado":"vivo"
GET http://127.0.0.1:8000/health/live

### Salud: la base responde
# esperado: 200
# contiene: "estado":"listo"; "base":"disponible"
GET http://127.0.0.1:8000/health/ready

### Editoriales: alta válida
# esperado: 201
# captura: editorial_id
# contiene: "nombre":"Prueba 03 Editorial"; "pais":"Argentina"
POST http://127.0.0.1:8000/editoriales/
Content-Type: application/json

{
  "nombre": "Prueba 03 Editorial",
  "pais": "Argentina"
}

### Editoriales: alta repetida
# esperado: 409
# contiene: "detail":"Ya existe una editorial con ese nombre."
# no-contiene: 23505; _key; duplicate key; editorial_nombre_key; Traceback
POST http://127.0.0.1:8000/editoriales/
Content-Type: application/json

{
  "nombre": "Prueba 03 Editorial",
  "pais": "Argentina"
}

### Editoriales: lectura por id
# esperado: 200
# contiene: "nombre":"Prueba 03 Editorial"; "pais":"Argentina"
GET http://127.0.0.1:8000/editoriales/{{editorial_id}}

### Editoriales: recurso inexistente
# esperado: 404
# contiene: "detail":"La editorial no existe."
GET http://127.0.0.1:8000/editoriales/9999

### Editoriales: PATCH de un solo campo
# esperado: 200
# contiene: "pais":"Chile"; "nombre":"Prueba 03 Editorial"
PATCH http://127.0.0.1:8000/editoriales/{{editorial_id}}
Content-Type: application/json

{
  "pais": "Chile"
}

### Editoriales: PATCH con cuerpo vacío no cambia nada
# esperado: 200
# contiene: "nombre":"Prueba 03 Editorial"; "pais":"Chile"
PATCH http://127.0.0.1:8000/editoriales/{{editorial_id}}
Content-Type: application/json

{}

### Editoriales: el alta no admite id
# esperado: 422
# no-contiene: "detail":"Not Found"
POST http://127.0.0.1:8000/editoriales/
Content-Type: application/json

{
  "id": 99,
  "nombre": "Prueba 03 Editorial Con Id"
}

### Editoriales: el alta no admite campos desconocidos
# esperado: 422
# no-contiene: "detail":"Not Found"
POST http://127.0.0.1:8000/editoriales/
Content-Type: application/json

{
  "nombre": "Prueba 03 Editorial Con Campo",
  "desconocido": true
}

### Géneros: alta válida
# esperado: 201
# captura: genero_id
# contiene: "nombre":"Prueba 03 Genero"
POST http://127.0.0.1:8000/generos/
Content-Type: application/json

{
  "nombre": "Prueba 03 Genero"
}

### Géneros: alta repetida
