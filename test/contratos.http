# lista-vacia: si
GET http://127.0.0.1:8000/autores/{{autor_id}}/libros

### Libros: búsqueda parcial por título
# esperado: 200
# cantidad: 1
# contiene: "titulo":"Rayuela"
GET http://127.0.0.1:8000/libros/?titulo=ray

### Libros: intento de inyección sin coincidencias
# esperado: 200
# lista-vacia: si
GET http://127.0.0.1:8000/libros/?titulo=%27%20OR%20%271%27%3D%271

### Libros: filtro por género
# esperado: 200
# cantidad: 1
# todos-genero: 1
GET http://127.0.0.1:8000/libros/?genero_id=1

### Libros: detalle con relaciones
# esperado: 200
# contiene: "editorial":{"id":1; "genero":{"id":1; "autores":[; "rol":"autor"; "orden":1
GET http://127.0.0.1:8000/libros/1

### Libros: PATCH de stock
# esperado: 200
# contiene: "stock":11; "precio":"24500.00"
PATCH http://127.0.0.1:8000/libros/1
Content-Type: application/json

{
  "stock": 11
}

### Libros: precio inválido
# esperado: 422
PATCH http://127.0.0.1:8000/libros/1
Content-Type: application/json

{
  "precio": 0
}

### Libros: alta con autorías
# esperado: 201
# captura: libro_04_id
# contiene: "titulo":"Prueba 04 Libro Contratos"; "precio":"21000.00"; "editorial":{"id":1; "genero":{"id":1; "autores":[; "rol":"coautor"; "orden":1; "orden":2
# no-contiene: 23505; _key; Traceback
POST http://127.0.0.1:8000/libros/
Content-Type: application/json

{
  "isbn": "978-950-04-0100-4",
  "titulo": "Prueba 04 Libro Contratos",
  "precio": "21000.00",
  "stock": 4,
  "editorial_id": 1,
  "genero_id": 1,
  "autores": [
    { "autor_id": 3, "rol": "coautor", "orden": 1 },
    { "autor_id": 4, "rol": "coautor", "orden": 2 }
  ]
}

### Libros: ISBN repetido en el alta
# esperado: 409
# contiene: "detail":"El ISBN ya pertenece a otro libro."
# no-contiene: 23505; _key; duplicate key; Traceback
POST http://127.0.0.1:8000/libros/
Content-Type: application/json

{
  "isbn": "978-950-04-0100-4",
  "titulo": "Prueba 04 Libro Contratos",
  "precio": "21000.00",
  "stock": 4,
  "editorial_id": 1,
  "genero_id": 1,
  "autores": [
    { "autor_id": 3, "rol": "coautor", "orden": 1 },
    { "autor_id": 4, "rol": "coautor", "orden": 2 }
  ]
}

### Libros: lectura del alta con relaciones
# esperado: 200
# contiene: "titulo":"Prueba 04 Libro Contratos"; "editorial":{"id":1; "genero":{"id":1; "autores":[
GET http://127.0.0.1:8000/libros/{{libro_04_id}}

