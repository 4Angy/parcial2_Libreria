### Ventas: listado paginado
# esperado: 200
# cantidad: 1
GET http://127.0.0.1:8000/ventas/?limit=1&offset=0

### Ventas: detalle con cliente y renglones
# esperado: 200
# contiene: "cliente":{"id":1; "renglones":[; "subtotal":
GET http://127.0.0.1:8000/ventas/1

### Ventas: recurso inexistente
# esperado: 404
# contiene: "detail":"La venta no existe."
GET http://127.0.0.1:8000/ventas/9999

### Ventas: alta previa del cliente Prueba 04
# esperado: 201
# captura: cliente_venta_04_id
# contiene: "email":"prueba04-venta@example.com"; "perfil":null
POST http://127.0.0.1:8000/clientes/
Content-Type: application/json

{
  "nombre": "Prueba 04 Cliente Venta",
  "email": "prueba04-venta@example.com"
}

### Ventas: alta válida con dos renglones
# esperado: 201
# captura: venta_04_id
# contiene: "total":"68900.00"; "cliente":{"id":; "renglones":[{; "precio_unitario":"24500.00"; "subtotal":"49000.00"; "precio_unitario":"19900.00"; "subtotal":"19900.00"
# termina-en-z: fecha
# no-contiene: 23503; _key; Traceback
POST http://127.0.0.1:8000/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_venta_04_id}},
  "renglones": [
    { "libro_id": 1, "cantidad": 2 },
    { "libro_id": 4, "cantidad": 1 }
  ]
}

### Ventas: el detalle coincide con el alta
# esperado: 200
# contiene: "total":"68900.00"; "renglones":[
GET http://127.0.0.1:8000/ventas/{{venta_04_id}}

### Ventas: la actualización no está definida
# esperado: 405
PATCH http://127.0.0.1:8000/ventas/1
Content-Type: application/json

{
  "total": "1.00"
}

# ---------------------------------------------------------------------------
# Limpieza de las filas creadas por las pruebas.
# El change no expone endpoints DELETE, así que se ejecuta con psql:
#
# docker exec pg-libreria psql -U libreria -d libreria -c "
# DELETE FROM renglon_venta WHERE venta_id IN (SELECT id FROM venta WHERE cliente_id IN (SELECT id FROM cliente WHERE nombre LIKE 'Prueba 03%' OR email LIKE 'prueba03%' OR nombre LIKE 'Prueba 04%' OR email LIKE 'prueba04%'));
# DELETE FROM venta WHERE cliente_id IN (SELECT id FROM cliente WHERE nombre LIKE 'Prueba 03%' OR email LIKE 'prueba03%' OR nombre LIKE 'Prueba 04%' OR email LIKE 'prueba04%');
# DELETE FROM perfil_cliente WHERE cliente_id IN (SELECT id FROM cliente WHERE nombre LIKE 'Prueba 03%' OR email LIKE 'prueba03%' OR nombre LIKE 'Prueba 04%' OR email LIKE 'prueba04%');
# DELETE FROM libro_autor WHERE libro_id IN (SELECT id FROM libro WHERE titulo LIKE 'Prueba 03%' OR titulo LIKE 'Prueba 04%' OR isbn = '978-950-04-0100-4');
# DELETE FROM renglon_venta WHERE libro_id IN (SELECT id FROM libro WHERE titulo LIKE 'Prueba 03%' OR titulo LIKE 'Prueba 04%' OR isbn = '978-950-04-0100-4');
# DELETE FROM libro WHERE titulo LIKE 'Prueba 03%' OR titulo LIKE 'Prueba 04%' OR isbn = '978-950-04-0100-4';
# DELETE FROM cliente WHERE nombre LIKE 'Prueba 03%' OR email LIKE 'prueba03%' OR nombre LIKE 'Prueba 04%' OR email LIKE 'prueba04%';
# DELETE FROM autor WHERE nombre LIKE 'Prueba 03%';
# DELETE FROM genero WHERE nombre LIKE 'Prueba 03%';
# DELETE FROM editorial WHERE nombre LIKE 'Prueba 03%';
# "
# ---------------------------------------------------------------------------
