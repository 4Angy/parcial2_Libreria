# Altas con relaciones del change 04: libros con autorías y ventas con renglones.
#
# Ejecutar con `uvicorn app.main:app --port 8000` y la base sembrada.
# Cada bloque declara `# esperado:` y las comprobaciones del ejecutor:
#   # captura: nombre        guarda el `id` de la respuesta y `{{nombre}}` lo reutiliza
#   # contiene: a; b         fragmentos que deben aparecer en el cuerpo
#   # no-contiene: a; b      fragmentos que no deben aparecer
#   # cantidad: n            cantidad de elementos de una lista
#   # lista-vacia: si        el cuerpo debe ser `[]`
#   # es-null: campo         el campo debe ser `null`
#   # termina-en-z: campo    el campo debe terminar en `Z`
#
# Los libros de prueba usan el prefijo `Prueba 04` o un ISBN propio del archivo.
# La venta literal de la consigna usa el cliente sembrado 2 y se limpia por el
# `id` que devuelve el alta. El bloque SQL de limpieza está al final.

### Libros: alta literal de la consigna
# esperado: 201
# captura: libro_consigna_id
# contiene: "titulo":"Los que aman, odian"; "precio":"21000.00"; "stock":4; "editorial":{"id":1; "genero":{"id":1; "autores":[; "rol":"coautor"; "orden":1; "orden":2
# no-contiene: 23505; _key; Traceback
POST http://127.0.0.1:8000/libros/
Content-Type: application/json

{
  "isbn": "978-950-00-0006-6",
  "titulo": "Los que aman, odian",
  "precio": "21000.00",
  "stock": 4,
  "editorial_id": 1,
  "genero_id": 1,
  "autores": [
    { "autor_id": 3, "rol": "coautor", "orden": 1 },
    { "autor_id": 4, "rol": "coautor", "orden": 2 }
  ]
}

### Libros: alta con lista de autores vacía
# esperado: 201
# captura: libro_sin_autores_id
# contiene: "titulo":"Prueba 04 Libro Sin Autores"; "autores":[]
POST http://127.0.0.1:8000/libros/
Content-Type: application/json

{
  "isbn": "978-950-04-0001-1",
  "titulo": "Prueba 04 Libro Sin Autores",
  "precio": "12000.00",
  "stock": 2,
  "editorial_id": 2,
  "genero_id": 2,
  "autores": []
}

