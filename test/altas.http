### Ventas: la actualización no está definida
# esperado: 405
PATCH http://127.0.0.1:8000/ventas/{{venta_consigna_id}}
Content-Type: application/json

{
  "total": "1.00"
}

# ---------------------------------------------------------------------------
# Limpieza de las filas creadas por las pruebas.
# El change no expone endpoints DELETE, así que se ejecuta con psql. La venta
# de la consigna usa el cliente sembrado 2: se borra por el `id` que devolvió
# el alta (`venta_consigna_id`, impreso por el ejecutor).
#
# docker exec pg-libreria psql -U libreria -d libreria -c "
# DELETE FROM renglon_venta WHERE venta_id = <venta_consigna_id>;
# DELETE FROM venta WHERE id = <venta_consigna_id>;
# DELETE FROM libro_autor WHERE libro_id IN (SELECT id FROM libro WHERE isbn IN ('978-950-00-0006-6', '978-950-04-0001-1', '978-950-04-0002-8') OR titulo LIKE 'Prueba 04%');
# DELETE FROM renglon_venta WHERE libro_id IN (SELECT id FROM libro WHERE isbn IN ('978-950-00-0006-6', '978-950-04-0001-1', '978-950-04-0002-8') OR titulo LIKE 'Prueba 04%');
# DELETE FROM libro WHERE isbn IN ('978-950-00-0006-6', '978-950-04-0001-1', '978-950-04-0002-8') OR titulo LIKE 'Prueba 04%';
# DELETE FROM cliente WHERE nombre LIKE 'Prueba 04%' OR email LIKE 'prueba04%';
# "
# ---------------------------------------------------------------------------
