### Ventas: alta literal de la consigna
# esperado: 201
# captura: venta_consigna_id
# contiene: "total":"68900.00"; "cliente":{"id":2; "renglones":[{; "precio_unitario":"24500.00"; "subtotal":"49000.00"; "precio_unitario":"19900.00"; "subtotal":"19900.00"
# termina-en-z: fecha
# no-contiene: 23503; _key; Traceback
POST http://127.0.0.1:8000/ventas/
Content-Type: application/json

{
  "cliente_id": 2,
  "renglones": [
    { "libro_id": 1, "cantidad": 2 },
    { "libro_id": 4, "cantidad": 1 }
  ]
}

### Ventas: el detalle coincide con el alta
# esperado: 200
# contiene: "total":"68900.00"; "renglones":[
# termina-en-z: fecha
GET http://127.0.0.1:8000/ventas/{{venta_consigna_id}}

### Ventas: sin renglones
# esperado: 422
POST http://127.0.0.1:8000/ventas/
Content-Type: application/json

{
  "cliente_id": 2,
  "renglones": []
}

